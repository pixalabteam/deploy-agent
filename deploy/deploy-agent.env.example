# Copy this file to /etc/deploy-agent/deploy-agent.env (chmod 600, readable only by
# root/deploy-agent) and fill in real values. The systemd unit loads it via EnvironmentFile=.

LISTEN_ADDR=127.0.0.1:8080

# Secret used to verify the HMAC-SHA256 signature of every webhook (header X-Signature-256).
# Use a random value, e.g. `openssl rand -hex 32`.
DEPLOY_WEBHOOK_SECRET=

# Required. JSON file describing projects and services
# (see deploy/projects.json.example and the "Projects" section of the README).
PROJECTS_FILE=/etc/deploy-agent/projects.json

HEALTH_CHECK_TIMEOUT_SEC=60
HEALTH_CHECK_INTERVAL_SEC=2

# Worker containers have no HTTP health check: they count as healthy if they are
# still running after WORKER_STABILIZE_SEC seconds.
WORKER_STABILIZE_SEC=10

STATE_FILE=/var/lib/deploy-agent/state.json

# By default these need passwordless sudo for the two commands; see the README
# section "nginx permissions".
NGINX_TEST_CMD=sudo nginx -t
NGINX_RELOAD_CMD=sudo systemctl reload nginx

# Leave empty if your containers reach other services through public IPs/hostnames
# instead of a named Docker network. Can also be set per project in projects.json.
DOCKER_NETWORK=

# Web dashboard at GET /admin/ (see the README section "Dashboard"). Leave both
# empty (the default) and the route returns 404, so nothing extra is exposed.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Image cleanup after every successful deploy: keep the N newest images of the
# deployed repository (>= 2: the running one plus the previous one for rollback) and
# delete build cache older than the given age. Volumes are never touched.
IMAGE_KEEP_COUNT=2
BUILD_CACHE_MAX_AGE=72h

# "Update deploy-agent" button on the dashboard: URL of the binary ({arch} becomes
# amd64/arm64) with a matching <url>.sha256 next to it. Leave empty to disable the
# button. The token is only needed for private repositories.
AGENT_UPDATE_URL=https://github.com/pixalabteam/deploy-agent/releases/latest/download/deploy-agent-linux-{arch}
AGENT_UPDATE_TOKEN=
