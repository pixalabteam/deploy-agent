# Example content of /etc/nginx/conf.d/myapp-api-upstream.conf as generated by
# deploy-agent (nginxctl.Render). For reference only: you do NOT need to create this
# file by hand before the first run of deploy-agent (see the README for the
# first-deploy placeholder). It shows what the agent will write.

upstream myapp_api {
    # Only with "sticky_sessions": true: long-lived streams (e.g. SSE) and the requests
    # tied to them must hit the same instance because the app keeps per-process state.
    ip_hash;
    server 127.0.0.1:3101;
    server 127.0.0.1:3111;
}
